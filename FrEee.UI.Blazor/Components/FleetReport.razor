@using FrEee.Objects.Civilization
@using FrEee.Objects.Space
@using FrEee.Extensions
@using FrEee.Vehicles.Types
@namespace FrEee.UI.Blazor.Components
@inherits ViewBase<FleetReportViewModel>

<div class="fleet-report" style="background-color: black; color: white; border: 1px solid cornflowerblue; padding: 8px;">
    @if (VM.Fleet is not null)
    {
        var f = VM.Fleet;
        <div style="display: flex; gap: 12px; margin-bottom: 8px;">
            <div style="width: 100px; height: 100px; border: 1px solid #444;">
                <ImageDisplay VM="@(new ImageDisplayViewModel { Image = f.Portrait })" />
            </div>
            <div style="flex: 1;">
                <h4 style="color: cornflowerblue; margin-bottom: 4px;">@f.Name</h4>
                <div style="font-size: 13px; color: #fff;">Owner: @(f.Owner?.Name ?? "None") | Vehicles: @f.LeafVehicles.Count()</div>
                <div style="font-size: 13px; color: #fff;">Hull Size: @(f.LeafVehicles.Sum(v => v.Design.Hull.Size).Kilotons()) | Speed: @f.StrategicSpeed</div>
                <div style="font-size: 13px; color: #fff;">Shields: @f.ShieldHitpoints / @f.MaxShieldHitpoints | Armor: @f.ArmorHitpoints / @f.MaxArmorHitpoints | Hull: @f.HullHitpoints / @f.MaxHullHitpoints</div>
                <div style="font-size: 13px; color: #aaa;">Supplies: @f.SupplyRemaining / @f.SupplyStorage</div>
            </div>
        </div>

        <div style="margin-top: 8px; border-top: 1px solid #333; padding-top: 6px;">
            <h6 style="color: cornflowerblue;">Vehicles &amp; Subfleets</h6>
            <div style="max-height: 150px; overflow-y: auto;">
                <table class="table table-dark table-sm" style="font-size: 12px; margin-bottom: 0;">
                    <tbody>
                        @foreach (var v in f.Vehicles)
                        {
                            <tr>
                                <td>@v.Name</td>
                                <td>@(v is ISpaceVehicle sv ? sv.Design.Role : "Subfleet")</td>
                                <td>@(v is ISpaceVehicle sv2 ? sv2.Design.Hull.Size.Kilotons() : "")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div style="margin-top: 8px; border-top: 1px solid #333; padding-top: 6px;">
            <h6 style="color: cornflowerblue;">Abilities</h6>
            <AbilityTreeView VM="@(new AbilityTreeViewModel { Abilities = f.AbilityTree(), IntrinsicAbilities = f.IntrinsicAbilities })" />
        </div>
    }
    else
    {
        <div style="color: #666; font-style: italic;">No fleet selected</div>
    }
</div>
