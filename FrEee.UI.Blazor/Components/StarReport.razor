@using FrEee.Objects.Space
@using FrEee.Extensions
@namespace FrEee.UI.Blazor.Components
@inherits ViewBase<StarReportViewModel>

<div class="star-report" style="background-color: black; color: white; border: 1px solid cornflowerblue; padding: 8px;">
    @if (VM.Star is not null)
    {
        var s = VM.Star;
        <div style="display: flex; gap: 12px; margin-bottom: 8px;">
            <div style="width: 100px; height: 100px; border: 1px solid #444;">
                <ImageDisplay VM="@(new ImageDisplayViewModel { Image = s.Portrait })" />
            </div>
            <div style="flex: 1;">
                <h4 style="color: cornflowerblue; margin-bottom: 4px;">@s.Name</h4>
                <div style="font-size: 13px; color: #fff;">Brightness: @s.Brightness | Color: @s.Color | Age: @s.Age</div>
                <div style="font-size: 13px; color: #aaa;">@s.Description</div>
            </div>
        </div>

        <div style="margin-top: 8px; border-top: 1px solid #333; padding-top: 6px;">
            <h6 style="color: cornflowerblue;">Abilities</h6>
            <AbilityTreeView VM="@(new AbilityTreeViewModel { Abilities = s.Abilities.StackToTree(s), IntrinsicAbilities = s.Abilities })" />
        </div>
    }
    else
    {
        <div style="color: #666; font-style: italic;">No star selected</div>
    }
</div>
