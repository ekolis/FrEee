@namespace FrEee.UI.Blazor.Components
@inherits ViewBase<GameTabControlViewModel>

<div class="game-tab-control" style="background-color: #@VM.BackColor.ToRgba(); width: 100%; display: flex; flex-direction: column;">
    <div class="game-tab-headers" style="display: flex; flex-direction: row; border-bottom: 2px solid #@VM.TabBorderColor.ToRgba(); gap: 2px;">
        @for (int i = 0; i < VM.Tabs.Count; i++)
        {
            var index = i;
            var tab = VM.Tabs[i];
            var isSelected = index == VM.SelectedIndex;
            var bg = isSelected ? VM.SelectedTabBackColor.ToRgba() : VM.TabBackColor.ToRgba();
            var fg = isSelected ? VM.SelectedTabForeColor.ToRgba() : VM.TabForeColor.ToRgba();

            <button type="button"
                    class="btn btn-sm"
                    @onclick="() => SelectTab(index)"
                    style="background-color: #@bg; color: #@fg; border: 1px solid #@VM.TabBorderColor.ToRgba(); border-bottom: none; border-radius: 4px 4px 0 0; padding: 4px 12px; font-weight: bold; cursor: pointer;">
                @tab.Text
            </button>
        }
    </div>
    <div class="game-tab-body" style="padding: 8px 0; flex: 1;">
        @ChildContent
    </div>
</div>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private void SelectTab(int index)
    {
        VM.SelectedIndex = index;
        VM.SelectedIndexChanged?.Invoke(index);
    }
}
