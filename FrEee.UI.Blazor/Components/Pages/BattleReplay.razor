@attribute [Route(PagePaths.BattleReplay)]
@using FrEee.UI.Blazor.Components
@inherits PageBase<BattleReplayViewModel>

<div class="battle-replay" style="background-color: black; color: white; padding: 16px; border: 1px solid cornflowerblue; width: 100%; height: 100%; display: flex; flex-direction: column;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h3 style="color: cornflowerblue; margin: 0;">Combat Replay</h3>
        <button class="btn btn-outline-secondary" @onclick="() => VM.Close()">Close</button>
    </div>

    <div style="flex: 1; overflow: hidden;">
        <BattleView VM="@(new BattleViewModel { Battle = VM.Battle })" />
    </div>
</div>
