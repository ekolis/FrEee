@attribute [Route(PagePaths.LoadGame)]
@inherits PageBase<LoadGameViewModel>

<div class="game-setup" style="background-color: black; color: white; padding: 16px; border: 1px solid cornflowerblue; width: 100%; height: 100%; overflow-y: auto;">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        <div style="border: 1px solid #333; padding: 12px;">
            <h5 style="color: cornflowerblue;">Games</h5>
            @foreach (var game in VM.GameTurns)
            {
                <button style="width: 100%; display: block" @onclick="() => VM.SelectGame(game.Key)">@game.Key</button>
            }
        </div>
        
        <div style="border: 1px solid #333; padding: 12px;">
            @if (VM.SelectedGameName is not null)
            {
                <h5 style="color: cornflowerblue;">@VM.SelectedGameName Turns</h5>
                @foreach (var turn in VM.GameTurns[VM.SelectedGameName])
                {
                    <button style="width: 100%; display: block" @onclick="() => VM.LoadTurn(turn)">Turn @turn.TurnNumber, player @turn.PlayerNumber</button>
                }
            }
        </div>
    </div>
</div>
