@attribute [Route(PagePaths.Home)]
@inherits ViewBase<HomeViewModel>

<PageTitle>FrEee</PageTitle>

<div class="main-menu container-fluid h-100">
    <div class="row h-100">
        <div class="col-8 d-flex align-items-center justify-content-center">
            <img src="Pictures/UI/Splash.png" alt="FrEee" class="img-fluid splash-image" />
        </div>
        <div class="col-4 d-flex flex-column justify-content-center align-items-center button-panel">
            <button class="btn btn-outline-primary mb-2 w-75" @onclick='() => Navigation.NavigateTo(PagePaths.ModPicker)'>Mods</button>
            <button class="btn btn-outline-primary mb-2 w-75" @onclick='() => Navigation.NavigateTo(PagePaths.GameSetup)'>New Game</button>
            <button class="btn btn-outline-primary mb-2 w-75" @onclick='() => AlertStub("Quick Start")'>Quick Start</button>
            <button class="btn btn-outline-primary mb-2 w-75" @onclick='() => AlertStub("Resume Game")'>Resume Game</button>
            <button class="btn btn-outline-primary mb-2 w-75" @onclick='() => AlertStub("Load Game")'>Load Game</button>
            <button class="btn btn-outline-primary mb-2 w-75" @onclick='() => AlertStub("Scenario")'>Scenario</button>
            <button class="btn btn-outline-primary mb-2 w-75" @onclick='() => Navigation.NavigateTo(PagePaths.Options)'>Options</button>
            <button class="btn btn-outline-primary mb-2 w-75" @onclick='() => AlertStub("Credits")'>Credits</button>
        </div>
    </div>
</div>

<style>
    .main-menu {
        background-color: black;
        color: cornflowerblue;
    }
    .splash-image {
        max-height: 90vh;
    }
    .button-panel {
        background-color: rgba(0, 0, 0, 0.5);
    }
    .btn-outline-primary {
        color: cornflowerblue;
        border-color: cornflowerblue;
    }
    .btn-outline-primary:hover {
        background-color: cornflowerblue;
        color: black;
    }
</style>
