@namespace FrEee.UI.Blazor.Components
@inherits ViewBase<PagerViewModel>

<div class="pager-control" style="width: 100%; display: flex; flex-direction: column;">
    @if (VM.ShowPager && VM.TotalPages > 1)
    {
        <div class="pager-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; padding: 2px 4px; background-color: #111; border: 1px solid cornflowerblue;">
            <button class="btn btn-sm btn-outline-primary" disabled="@(!VM.CanPrev)" @onclick="() => VM.Prev()">&lt; Prev</button>
            <span style="color: cornflowerblue; font-size: 13px;">Page @(VM.CurrentPage + 1) of @(Math.Max(1, VM.TotalPages))</span>
            <button class="btn btn-sm btn-outline-primary" disabled="@(!VM.CanNext)" @onclick="() => VM.Next()">Next &gt;</button>
        </div>
    }
    <div class="pager-body" style="flex: 1;">
        @ChildContent
    </div>
</div>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
