@using FrEee.Processes.Combat
@namespace FrEee.UI.Blazor.Components
@inherits ViewBase<BattleViewModel>

<div class="battle-view" style="background-color: black; color: white; border: 1px solid cornflowerblue; padding: 6px; display: flex; flex-direction: column; align-items: center; width: 100%; height: 100%; min-height: 400px; overflow: auto;">
    @if (VM.Battle is not null)
    {
        <div class="battle-controls" style="display: flex; gap: 8px; align-items: center; margin-bottom: 8px;">
            <button class="btn btn-sm btn-outline-primary" @onclick="() => VM.PrevRound()">&lt;&lt; Prev Round</button>
            <button class="btn btn-sm btn-outline-secondary" @onclick="() => VM.TogglePause()">@(VM.IsPaused ? "Play" : "Pause")</button>
            <button class="btn btn-sm btn-outline-primary" @onclick="() => VM.NextRound()">Next Round &gt;&gt;</button>
            <span style="color: cornflowerblue; font-weight: bold; font-size: 13px;">
                Round: @(VM.Round + 1) / @(VM.Battle.Duration)
            </span>
        </div>

        var combatants = VM.Battle.Combatants.ToList();
        <div style="width: 100%; max-width: 600px; background-color: #111; border: 1px solid #333; padding: 8px; min-height: 300px; display: flex; flex-direction: column; gap: 4px;">
            <div style="color: cornflowerblue; font-weight: bold; font-size: 13px; border-bottom: 1px solid #333; padding-bottom: 4px;">
                Combatants (@combatants.Count)
            </div>
            @foreach (var c in combatants)
            {
                var isSelected = c == VM.SelectedCombatant;
                <div @onclick="() => VM.SelectedCombatant = c"
                     style="display: flex; align-items: center; justify-content: space-between; padding: 4px 8px; background-color: @(isSelected ? "#003366" : "#1a1a1a"); border: 1px solid @(isSelected ? "cornflowerblue" : "#222"); cursor: pointer;">
                    <div style="display: flex; align-items: center; gap: 6px;">
                        <div style="width: 24px; height: 24px;">
                            <ImageDisplay VM="@(new ImageDisplayViewModel { Image = c.Icon })" />
                        </div>
                        <span style="font-size: 13px; color: white;">@c.Name</span>
                    </div>
                    <div style="font-size: 12px; color: #aaa;">
                        HP: @c.HullHitpoints / @c.MaxHullHitpoints | Shld: @c.ShieldHitpoints / @c.MaxShieldHitpoints
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div style="color: #666; font-style: italic;">No battle loaded</div>
    }
</div>
