@using FrEee.Objects.Space
@using FrEee.Extensions
@namespace FrEee.UI.Blazor.Components
@inherits ViewBase<WarpPointReportViewModel>

<div class="warp-point-report" style="background-color: black; color: white; border: 1px solid cornflowerblue; padding: 8px;">
    @if (VM.WarpPoint is not null)
    {
        var wp = VM.WarpPoint;
        <div style="display: flex; gap: 12px; margin-bottom: 8px;">
            <div style="width: 100px; height: 100px; border: 1px solid #444;">
                <ImageDisplay VM="@(new ImageDisplayViewModel { Image = wp.Portrait })" />
            </div>
            <div style="flex: 1;">
                <h4 style="color: cornflowerblue; margin-bottom: 4px;">@wp.Name</h4>
                <div style="font-size: 13px; color: #fff;">Destination: @(wp.Target?.StarSystem?.Name ?? "Unknown")</div>
                <div style="font-size: 13px; color: #aaa;">@wp.Description</div>
            </div>
        </div>

        <div style="margin-top: 8px; border-top: 1px solid #333; padding-top: 6px;">
            <h6 style="color: cornflowerblue;">Abilities</h6>
            <AbilityTreeView VM="@(new AbilityTreeViewModel { Abilities = wp.AbilityTree(), IntrinsicAbilities = wp.IntrinsicAbilities })" />
        </div>
    }
    else
    {
        <div style="color: #666; font-style: italic;">No warp point selected</div>
    }
</div>
