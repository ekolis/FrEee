@page "/fleet-transfer"
@using FrEee.UI.Blazor.Components
@using FrEee.UI.Blazor.Components.Screens
@using FrEee.Objects.Space
@using FrEee.Vehicles.Types
@inherits ScreenBase<FleetTransferViewModel>

<div class="fleet-transfer-screen" style="background-color: black; color: white; padding: 16px; border: 1px solid cornflowerblue; width: 100%; height: 100%; display: flex; flex-direction: column;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h3 style="color: cornflowerblue; margin: 0;">Fleet Transfer</h3>
        <button class="btn btn-outline-secondary" @onclick="() => VM.Close()">Close</button>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; flex: 1;">
        <div style="border: 1px solid #333; padding: 8px;">
            <h5 style="color: cornflowerblue;">Source: @(VM.SourceFleet?.Name ?? "None")</h5>
            <div style="max-height: 350px; overflow-y: auto;">
                <ul style="list-style: none; padding-left: 0;">
                    @if (VM.SourceFleet is not null)
                    {
                        @foreach (var v in VM.SourceFleet.Vehicles.OfType<ISpaceVehicle>())
                        {
                            <li style="display: flex; justify-content: space-between; padding: 4px; border-bottom: 1px solid #222;">
                                <span>@v.Name</span>
                                @if (VM.TargetFleet is not null)
                                {
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => VM.TransferVehicle(v, VM.SourceFleet, VM.TargetFleet)">&gt;&gt;</button>
                                }
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>

        <div style="border: 1px solid #333; padding: 8px;">
            <h5 style="color: cornflowerblue;">Target: @(VM.TargetFleet?.Name ?? "None")</h5>
            <div style="max-height: 350px; overflow-y: auto;">
                <ul style="list-style: none; padding-left: 0;">
                    @if (VM.TargetFleet is not null)
                    {
                        @foreach (var v in VM.TargetFleet.Vehicles.OfType<ISpaceVehicle>())
                        {
                            <li style="display: flex; justify-content: space-between; padding: 4px; border-bottom: 1px solid #222;">
                                <span>@v.Name</span>
                                @if (VM.SourceFleet is not null)
                                {
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => VM.TransferVehicle(v, VM.TargetFleet, VM.SourceFleet)">&lt;&lt;</button>
                                }
                            </li>
                        }
                    }
                </ul>
            </div>
        </div>
    </div>
</div>
