@page "/empire-setup"
@using FrEee.UI.Blazor.Components
@using FrEee.UI.Blazor.Components.Screens
@using FrEee.Modding
@inherits ScreenBase<EmpireSetupViewModel>

<div class="empire-setup-screen" style="background-color: black; color: white; padding: 16px; border: 1px solid cornflowerblue; width: 100%; height: 100%; overflow-y: auto;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h3 style="color: cornflowerblue; margin: 0;">Empire Setup</h3>
        <div style="display: flex; gap: 8px;">
            <button class="btn btn-outline-secondary" @onclick="() => VM.Close()">Cancel</button>
            <button class="btn btn-primary" @onclick="() => VM.Save()">Save</button>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
        <div style="border: 1px solid #333; padding: 12px;">
            <h5 style="color: cornflowerblue;">General Info</h5>
            <div class="mb-2">
                <label class="form-label" style="color: cornflowerblue; font-size: 13px;">Empire Name</label>
                <input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="VM.EmpireName" />
            </div>
            <div class="mb-2">
                <label class="form-label" style="color: cornflowerblue; font-size: 13px;">Leader Name</label>
                <input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="VM.LeaderName" />
            </div>
            <div class="mb-2">
                <label class="form-label" style="color: cornflowerblue; font-size: 13px;">Culture</label>
                <select class="form-select form-select-sm bg-dark text-white border-secondary"
                        @onchange="(e) => VM.SelectedCulture = Mod.Current?.Cultures.FirstOrDefault(c => c.Name == e.Value?.ToString())">
                    @if (Mod.Current is not null)
                    {
                        @foreach (var c in Mod.Current.Cultures)
                        {
                            <option value="@c.Name">@c.Name</option>
                        }
                    }
                </select>
            </div>
        </div>

        <div style="border: 1px solid #333; padding: 12px;">
            <h5 style="color: cornflowerblue;">Race Setup</h5>
            <div class="mb-2">
                <label class="form-label" style="color: cornflowerblue; font-size: 13px;">Race Name</label>
                <input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="VM.PrimaryRace.Name" />
            </div>
            <div class="mb-2">
                <label class="form-label" style="color: cornflowerblue; font-size: 13px;">Native Atmosphere</label>
                <input class="form-control form-control-sm bg-dark text-white border-secondary" @bind="VM.PrimaryRace.NativeAtmosphere" />
            </div>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 16px;">
        <div style="border: 1px solid #333; padding: 12px;">
            <h5 style="color: cornflowerblue;">Aptitudes</h5>
            <AptitudePicker VM="VM.AptitudePickerVM" />
        </div>
        <div style="border: 1px solid #333; padding: 12px;">
            <h5 style="color: cornflowerblue;">Traits</h5>
            <TraitPicker VM="VM.TraitPickerVM" />
        </div>
    </div>
</div>
