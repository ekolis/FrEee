@page "/mount-picker"
@using FrEee.UI.Blazor.Components
@using FrEee.UI.Blazor.Components.Screens
@using FrEee.Objects.Technology
@inherits ScreenBase<MountPickerViewModel>

<div class="mount-picker-screen" style="background-color: black; color: white; padding: 16px; border: 1px solid cornflowerblue; max-width: 600px; margin: 0 auto; display: flex; flex-direction: column;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h3 style="color: cornflowerblue; margin: 0;">Select Mount</h3>
        <button class="btn btn-outline-secondary" @onclick="() => VM.Close()">Cancel</button>
    </div>

    <div style="max-height: 350px; overflow-y: auto; border: 1px solid #333; margin-bottom: 16px;">
        <table class="table table-dark table-hover table-sm" style="font-size: 13px; margin-bottom: 0;">
            <thead>
                <tr style="color: cornflowerblue;">
                    <th>Code</th>
                    <th>Name</th>
                    <th>Size %</th>
                    <th>Cost %</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in VM.Mounts)
                {
                    var isSelected = m == VM.SelectedMount;
                    <tr @onclick="() => VM.SelectedMount = m"
                        style="cursor: pointer; background-color: @(isSelected ? "#003366" : "inherit");">
                        <td>@m.Code</td>
                        <td>@m.Name</td>
                        <td>@m.SizePercent.Value%</td>
                        <td>@m.CostPercent.Value%</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 8px;">
        <button class="btn btn-primary" disabled="@(VM.SelectedMount == null)" @onclick="() => VM.Select()">Select Mount</button>
    </div>
</div>
