@page "/scores"
@using FrEee.UI.Blazor.Components
@using FrEee.UI.Blazor.Components.Screens
@using FrEee.Objects.Civilization
@inherits ScreenBase<ScoresViewModel>

<div class="scores-screen" style="background-color: black; color: white; padding: 16px; border: 1px solid cornflowerblue; width: 100%; height: 100%; display: flex; flex-direction: column;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h3 style="color: cornflowerblue; margin: 0;">Empire Scores</h3>
        <button class="btn btn-outline-secondary" @onclick="() => VM.Close()">Close</button>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 300px; gap: 16px; flex: 1;">
        <div style="border: 1px solid #333; padding: 8px; display: flex; align-items: center; justify-content: center;">
            <LineGraph VM="VM.GraphVM" />
        </div>
        <div style="border: 1px solid #333; padding: 8px; overflow-y: auto;">
            <h5 style="color: cornflowerblue;">Rankings</h5>
            <ul style="list-style: none; padding-left: 0;">
                @{
                    var rank = 1;
                    foreach (var emp in VM.Empires)
                    {
                        <li style="padding: 6px 8px; border-bottom: 1px solid #222; display: flex; justify-content: space-between;">
                            <span style="color: #fff;">@(rank++). @emp.Name</span>
                            <span style="color: cornflowerblue;">@emp.Score</span>
                        </li>
                    }
                }
            </ul>
        </div>
    </div>
</div>
