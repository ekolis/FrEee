@page "/editor"
@using FrEee.UI.Blazor.Components
@using FrEee.UI.Blazor.Components.Screens
@using FrEee.Objects.GameState
@inherits ScreenBase<EditorViewModel>

<div class="editor-screen" style="background-color: black; color: white; padding: 16px; border: 1px solid cornflowerblue; width: 100%; height: 100%; display: flex; flex-direction: column;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h3 style="color: cornflowerblue; margin: 0;">Galaxy Editor</h3>
        <button class="btn btn-outline-secondary" @onclick="() => VM.Close()">Close</button>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 300px; gap: 16px; flex: 1;">
        <div style="border: 1px solid #333; padding: 8px;">
            <StarSystemView VM="@(new StarSystemViewModel { StarSystem = VM.SelectedStarSystem })" />
        </div>
        <div style="border: 1px solid #333; padding: 8px;">
            <h5 style="color: cornflowerblue;">Editor Tools</h5>
            <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 12px;">
                <button class="btn btn-outline-primary btn-sm">Add Star</button>
                <button class="btn btn-outline-primary btn-sm">Add Planet</button>
                <button class="btn btn-outline-primary btn-sm">Add Asteroids</button>
                <button class="btn btn-outline-primary btn-sm">Add Warp Point</button>
                <button class="btn btn-outline-danger btn-sm">Delete Object</button>
            </div>
        </div>
    </div>
</div>
