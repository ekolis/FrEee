@page "/combat-simulator"
@using FrEee.UI.Blazor.Components
@using FrEee.UI.Blazor.Components.Screens
@inherits ScreenBase<CombatSimulatorViewModel>

<div class="combat-simulator-screen" style="background-color: black; color: white; padding: 16px; border: 1px solid cornflowerblue; width: 100%; height: 100%; display: flex; flex-direction: column;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h3 style="color: cornflowerblue; margin: 0;">Combat Simulator</h3>
        <button class="btn btn-outline-secondary" @onclick="() => VM.Close()">Close</button>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; flex: 1;">
        <div style="border: 1px solid #333; padding: 8px;">
            <h5 style="color: cornflowerblue;">Side 1 (@VM.Side1.Count units)</h5>
            <ul style="list-style: none; padding-left: 0;">
                @foreach (var unit in VM.Side1)
                {
                    <li style="font-size: 13px; color: #fff;">@unit.Name (@unit.Design.Role)</li>
                }
            </ul>
        </div>
        <div style="border: 1px solid #333; padding: 8px;">
            <h5 style="color: #ff6666;">Side 2 (@VM.Side2.Count units)</h5>
            <ul style="list-style: none; padding-left: 0;">
                @foreach (var unit in VM.Side2)
                {
                    <li style="font-size: 13px; color: #fff;">@unit.Name (@unit.Design.Role)</li>
                }
            </ul>
        </div>
    </div>

    <div style="margin-top: 16px; display: flex; justify-content: flex-end;">
        <button class="btn btn-primary" @onclick="() => VM.StartSimulation()">Start Simulation</button>
    </div>
</div>
