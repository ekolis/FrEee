@page "/debug"
@using FrEee.UI.Blazor.Components
@using FrEee.UI.Blazor.Components.Screens
@inherits ScreenBase<DebugViewModel>

<div class="debug-screen" style="background-color: black; color: white; padding: 16px; border: 1px solid cornflowerblue; width: 100%; height: 100%; display: flex; flex-direction: column;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h3 style="color: cornflowerblue; margin: 0;">Debug Console</h3>
        <button class="btn btn-outline-secondary" @onclick="() => VM.Close()">Close</button>
    </div>

    <div style="flex: 1; background-color: #111; border: 1px solid #333; padding: 12px; font-family: monospace; font-size: 12px; white-space: pre-wrap; overflow-y: auto; color: #00ff00;">
        @VM.DebugLog
    </div>

    <div class="input-group mt-2">
        <input type="text"
               class="form-control bg-dark text-white border-secondary"
               placeholder="Enter debug command..."
               @bind="VM.CommandInput"
               @bind:event="oninput"
               @onkeyup="HandleKeyUp" />
        <button class="btn btn-outline-primary" @onclick="() => VM.ExecuteCommand()">Execute</button>
    </div>
</div>

@code {
    private void HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            VM.ExecuteCommand();
        }
    }
}
