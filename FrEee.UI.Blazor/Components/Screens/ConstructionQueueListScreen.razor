@page "/queues"
@using FrEee.UI.Blazor.Components
@using FrEee.UI.Blazor.Components.Screens
@using FrEee.Processes.Construction
@inherits ScreenBase<ConstructionQueueListViewModel>

<div class="queues-screen" style="background-color: black; color: white; padding: 16px; border: 1px solid cornflowerblue; width: 100%; height: 100%; display: flex; flex-direction: column;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h3 style="color: cornflowerblue; margin: 0;">Construction Queues</h3>
        <button class="btn btn-outline-secondary" @onclick="() => VM.Close()">Close</button>
    </div>

    <div style="display: grid; grid-template-columns: 280px 1fr; gap: 16px; flex: 1; overflow: hidden;">
        <div style="border: 1px solid #333; padding: 8px; overflow-y: auto;">
            <ul style="list-style: none; padding-left: 0;">
                @foreach (var q in VM.Queues)
                {
                    var isSelected = q == VM.SelectedQueue;
                    <li @onclick="() => VM.SelectedQueue = q"
                        style="padding: 6px 8px; cursor: pointer; background-color: @(isSelected ? "#003366" : "transparent"); border-bottom: 1px solid #222;">
                        <span style="color: @(isSelected ? "white" : "cornflowerblue"); font-size: 13px;">@q.Container?.Name</span>
                        <div style="font-size: 11px; color: #888;">Items: @q.Orders.Count()</div>
                    </li>
                }
            </ul>
        </div>

        <div style="border: 1px solid #333; padding: 8px; overflow-y: auto;">
            @if (VM.SelectedQueue is not null)
            {
                <h4 style="color: cornflowerblue;">@(VM.SelectedQueue.Container?.Name ?? "Queue")</h4>
                <div style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-dark table-sm table-hover" style="font-size: 13px;">
                        <thead>
                            <tr style="color: cornflowerblue;">
                                <th>#</th>
                                <th>Item</th>
                                <th>Cost</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var idx = 1;
                                foreach (var order in VM.SelectedQueue.Orders)
                                {
                                    <tr>
                                        <td>@(idx++)</td>
                                        <td>@order.Template.Name</td>
                                        <td>@order.Template.Cost</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div style="color: #666; font-style: italic; padding: 12px;">Select a queue to view.</div>
            }
        </div>
    </div>
</div>
