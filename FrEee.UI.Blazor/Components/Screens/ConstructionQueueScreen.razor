@page "/construction-queue"
@using FrEee.UI.Blazor.Components
@using FrEee.UI.Blazor.Components.Screens
@using FrEee.Processes.Construction
@using FrEee.Extensions
@inherits ScreenBase<ConstructionQueueViewModel>

<div class="construction-queue-screen" style="background-color: black; color: white; padding: 16px; border: 1px solid cornflowerblue; width: 100%; height: 100%; display: flex; flex-direction: column;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h3 style="color: cornflowerblue; margin: 0;">Construction Queue: @(VM.Queue?.Container?.Name ?? "None")</h3>
        <button class="btn btn-outline-secondary" @onclick="() => VM.Close()">Close</button>
    </div>

    <div style="flex: 1; overflow-y: auto; border: 1px solid #333; padding: 8px;">
        @if (VM.Queue is not null && VM.Queue.Orders.Any())
        {
            <table class="table table-dark table-sm table-hover" style="font-size: 13px;">
                <thead>
                    <tr style="color: cornflowerblue;">
                        <th>#</th>
                        <th>Item</th>
                        <th>Cost</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var idx = 1;
                        foreach (var order in VM.Queue.Orders)
                        {
                            <tr>
                                <td>@(idx++)</td>
                                <td>@order.Template.Name</td>
                                <td>@order.Template.Cost</td>
                                <td>
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => VM.MoveUp(order)">▲</button>
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => VM.MoveDown(order)">▼</button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => VM.Delete(order)">✕</button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
        else
        {
            <div style="color: #666; font-style: italic; padding: 12px;">Queue is empty.</div>
        }
    </div>
</div>
