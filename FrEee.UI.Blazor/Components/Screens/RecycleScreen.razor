@page "/recycle"
@using FrEee.UI.Blazor.Components
@using FrEee.UI.Blazor.Components.Screens
@using FrEee.Vehicles.Types
@inherits ScreenBase<RecycleViewModel>

<div class="recycle-screen" style="background-color: black; color: white; padding: 16px; border: 1px solid cornflowerblue; max-width: 600px; margin: 0 auto; display: flex; flex-direction: column;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h3 style="color: cornflowerblue; margin: 0;">Scrap / Recycle Units</h3>
        <button class="btn btn-outline-secondary" @onclick="() => VM.Close()">Close</button>
    </div>

    <div style="max-height: 350px; overflow-y: auto; border: 1px solid #333; margin-bottom: 16px;">
        <ul style="list-style: none; padding-left: 0; margin-bottom: 0;">
            @foreach (var v in VM.Vehicles)
            {
                var isSelected = v == VM.SelectedVehicle;
                <li @onclick="() => VM.SelectedVehicle = v"
                    style="padding: 6px 12px; cursor: pointer; background-color: @(isSelected ? "#003366" : "transparent"); border-bottom: 1px solid #222; display: flex; justify-content: space-between;">
                    <span style="color: @(isSelected ? "white" : "cornflowerblue"); font-size: 13px;">@v.Name (@v.Design.Role)</span>
                    <span style="color: #aaa; font-size: 12px;">@v.Sector?.StarSystem?.Name</span>
                </li>
            }
        </ul>
    </div>

    <div style="display: flex; justify-content: flex-end; gap: 8px;">
        <button class="btn btn-danger" disabled="@(VM.SelectedVehicle == null)" @onclick="() => VM.Scrap()">Scrap Vehicle</button>
    </div>
</div>
