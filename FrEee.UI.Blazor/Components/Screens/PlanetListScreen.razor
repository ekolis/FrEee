@page "/planets"
@using FrEee.UI.Blazor.Components
@using FrEee.UI.Blazor.Components.Screens
@using FrEee.Objects.Space
@using FrEee.Extensions
@inherits ScreenBase<PlanetListViewModel>

<div class="planet-list-screen" style="background-color: black; color: white; padding: 16px; border: 1px solid cornflowerblue; width: 100%; height: 100%; display: flex; flex-direction: column;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h3 style="color: cornflowerblue; margin: 0;">Colonies</h3>
        <button class="btn btn-outline-secondary" @onclick="() => VM.Close()">Close</button>
    </div>

    <div style="display: grid; grid-template-columns: 280px 1fr; gap: 16px; flex: 1; overflow: hidden;">
        <div style="border: 1px solid #333; padding: 8px; overflow-y: auto;">
            <ul style="list-style: none; padding-left: 0;">
                @foreach (var p in VM.ColonizedPlanets)
                {
                    var isSelected = p == VM.SelectedPlanet;
                    <li @onclick="() => VM.SelectedPlanet = p"
                        style="padding: 6px 8px; cursor: pointer; background-color: @(isSelected ? "#003366" : "transparent"); border-bottom: 1px solid #222;">
                        <span style="color: @(isSelected ? "white" : "cornflowerblue"); font-size: 13px;">@p.Name</span>
                        <div style="font-size: 11px; color: #888;">Pop: @p.Colony?.Population.Values.Sum().ToUnitString() | Sys: @p.StarSystem?.Name</div>
                    </li>
                }
            </ul>
        </div>

        <div style="border: 1px solid #333; padding: 8px; overflow-y: auto;">
            @if (VM.SelectedPlanet is not null)
            {
                <PlanetReport VM="@(new PlanetReportViewModel { Planet = VM.SelectedPlanet })" />
            }
            else
            {
                <div style="color: #666; font-style: italic; padding: 12px;">Select a planet to view report.</div>
            }
        </div>
    </div>
</div>
