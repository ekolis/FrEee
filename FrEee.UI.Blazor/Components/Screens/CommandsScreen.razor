@page "/commands"
@using FrEee.UI.Blazor.Components
@using FrEee.UI.Blazor.Components.Screens
@using FrEee.Gameplay.Commands
@inherits ScreenBase<CommandsViewModel>

<div class="commands-screen" style="background-color: black; color: white; padding: 16px; border: 1px solid cornflowerblue; width: 100%; height: 100%; display: flex; flex-direction: column;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h3 style="color: cornflowerblue; margin: 0;">Empire Commands</h3>
        <button class="btn btn-outline-secondary" @onclick="() => VM.Close()">Close</button>
    </div>

    <div style="flex: 1; overflow-y: auto; border: 1px solid #333; padding: 8px;">
        <table class="table table-dark table-sm table-hover" style="font-size: 13px;">
            <thead>
                <tr style="color: cornflowerblue;">
                    <th>#</th>
                    <th>Type</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var idx = 1;
                    foreach (var cmd in VM.Commands)
                    {
                        <tr>
                            <td>@(idx++)</td>
                            <td>@cmd.GetType().Name</td>
                            <td>@cmd.ToString()</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
