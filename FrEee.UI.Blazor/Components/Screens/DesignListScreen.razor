@page "/designs"
@using FrEee.UI.Blazor.Components
@using FrEee.UI.Blazor.Components.Screens
@using FrEee.Vehicles.Types
@inherits ScreenBase<DesignListViewModel>

<div class="designs-screen" style="background-color: black; color: white; padding: 16px; border: 1px solid cornflowerblue; width: 100%; height: 100%; display: flex; flex-direction: column;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h3 style="color: cornflowerblue; margin: 0;">Vehicle Designs</h3>
        <div style="display: flex; gap: 8px;">
            <a href="/vehicle-design" class="btn btn-sm btn-primary">Create Design</a>
            <button class="btn btn-outline-secondary btn-sm" @onclick="() => VM.Close()">Close</button>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: 280px 1fr; gap: 16px; flex: 1; overflow: hidden;">
        <div style="border: 1px solid #333; padding: 8px; overflow-y: auto;">
            <ul style="list-style: none; padding-left: 0;">
                @foreach (var d in VM.Designs)
                {
                    var isSelected = d == VM.SelectedDesign;
                    <li @onclick="() => VM.SelectedDesign = d"
                        style="padding: 6px 8px; cursor: pointer; background-color: @(isSelected ? "#003366" : "transparent"); border-bottom: 1px solid #222;">
                        <span style="color: @(isSelected ? "white" : "cornflowerblue"); font-size: 13px;">@d.Name</span>
                        <div style="font-size: 11px; color: #888;">@d.Role - @d.Hull.Name</div>
                    </li>
                }
            </ul>
        </div>

        <div style="border: 1px solid #333; padding: 8px; overflow-y: auto;">
            @if (VM.SelectedDesign is not null)
            {
                <DesignReport VM="@(new DesignReportViewModel { Design = VM.SelectedDesign })" />
            }
            else
            {
                <div style="color: #666; font-style: italic; padding: 12px;">Select a design to view.</div>
            }
        </div>
    </div>
</div>
