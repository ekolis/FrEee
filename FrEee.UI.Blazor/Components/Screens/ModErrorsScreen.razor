@page "/mod-errors"
@inherits ScreenBase<ModErrorsViewModel>

<div class="mod-errors-screen" style="background-color: black; color: white; padding: 16px; border: 1px solid cornflowerblue; width: 100%; height: 100%; display: flex; flex-direction: column;">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <h3 style="color: cornflowerblue; margin: 0;">Mod Errors</h3>
        <button class="btn btn-outline-secondary" @onclick="() => VM.Close()">Close</button>
    </div>

    <div style="flex: 1; overflow-y: auto; border: 1px solid #333; padding: 8px;">
        @if (VM.Errors.Any())
        {
            <table class="table table-dark table-sm" style="font-size: 13px;">
                <thead>
                    <tr style="color: #ff6666;">
                        <th>File</th>
                        <th>Record</th>
                        <th>Message</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var err in VM.Errors)
                    {
                        <tr>
                            <td>@err.Filename</td>
                            <td>@(err.Record?.ToString() ?? "")</td>
                            <td>@err.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div style="color: #666; padding: 12px;">No mod errors found.</div>
        }
    </div>
</div>
